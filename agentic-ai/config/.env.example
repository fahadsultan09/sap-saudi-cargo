# Local development configuration only. Do not use these settings in production.
APP_ENV=development
AUTH_MODE=dev

# Local SQLite database and document storage
AP_DATA_DIR=./runtime_data
AP_UPLOAD_DIR=./runtime_data/uploads
AP_DB_PATH=./runtime_data/ap_workflow.sqlite3
AP_MAX_UPLOAD_MB=20

# Offline mode: no live SAP credentials required
SAP_PROCESSING_ENABLED=false
AGENT_MODE=mock

# Browser origins for local UI5 / React development
AP_CORS_ORIGINS=http://localhost:8080,http://localhost:5173
LOG_LEVEL=INFO
