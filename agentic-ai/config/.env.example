# SACC AP POC shared configuration. Never commit real credentials.
CONFIGURED_COMPANY_CODE=
CONFIGURED_COMPANY_NAME=
CONFIGURED_COMPANY_VAT=
CONFIGURED_COMPANY_TAX_IDS=
INTERCOMPANY_COMPANY_CODES=
MIN_CONFIDENCE_THRESHOLD=0.75
MIN_REQUIRED_FIELD_CONFIDENCE=0.80

# Microsoft Graph intake, optional for the upload-based API
GRAPH_AUTH_MODE=none
GRAPH_API_BASE_URL=https://graph.microsoft.com/v1.0
GRAPH_USER_ID=
GRAPH_API_TOKEN=
GRAPH_TENANT_ID=
GRAPH_CLIENT_ID=
GRAPH_CLIENT_SECRET=

# API local development defaults
APP_ENV=development
AUTH_MODE=dev
AP_DATA_DIR=./runtime_data
AP_MAX_UPLOAD_MB=20
AP_CORS_ORIGINS=http://localhost:8080,http://localhost:5173
SAP_PROCESSING_ENABLED=true
# Real SAP processing profile: requires valid config/ai_core_cred.json and config/sap_credentials.json
# Paste the schema ID of your confirmed SAP Document AI invoice schema here.
SAP_DOX_SCHEMA_ID=
AGENT_MODE=sap
AP_APPROVER_MAX_AMOUNT=1000000

# Production auth example. Set AUTH_MODE=jwt and provide a trusted JWT issuer/secret.
# AUTH_JWT_SECRET=replace-with-at-least-32-random-characters
# AUTH_JWT_ISSUER=https://your-trusted-issuer.example
# AUTH_JWT_AUDIENCE=sacc-ap-api
