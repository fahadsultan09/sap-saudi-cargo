# Copy to gateway/.env (git-ignored) and fill in. Values here are placeholders, never real secrets.
AP_CORE_URL=http://127.0.0.1:8002
PORT=8000
HTTP_TIMEOUT=30
CLIENT_PROFILE=../clients/saudi-cargo
PUBLIC_URL=http://localhost:8000
FRONTEND_URL=http://localhost:8080

# Must equal AP_GATEWAY_CLIENT_SECRET in infra/.env (the Keycloak client secret).
OIDC_CLIENT_SECRET=change-me
# Must equal AP_CORE_SERVICE_API_KEY in ap-core-service/.env (the gateway's service key for AP Core).
AP_CORE_SERVICE_API_KEY=change-me
