<mvc:View
	controllerName="saudicargo.ap.automation.controller.Dashboard"
	xmlns:mvc="sap.ui.core.mvc"
	xmlns="sap.m"
	xmlns:core="sap.ui.core"
	xmlns:u="sap.ui.unified">
	<Page showHeader="false" backgroundDesign="Transparent" class="apSection">
		<VBox class="sapUiMediumMargin">
			<HBox class="apWelcome sapUiMediumMarginBottom" alignItems="Center"
				justifyContent="SpaceBetween" wrap="Wrap">
				<VBox>
					<Text text="AP Console · AP Automation" class="apWelcomeBrand"/>
					<Title text="{apData>/welcome/greeting}" level="H2"/>
					<Text text="{apData>/welcome/subtitle}" class="sapUiTinyMarginTop"/>
				</VBox>
				<HBox class="sapUiSmallMarginTopBottom" wrap="Wrap" alignItems="Center">
					<Button text="Upload invoice" icon="sap-icon://upload" press="onGoUpload"
						visible="{apData>/permissions/processor}" class="apLightButton sapUiSmallMarginEnd"
						enabled="{= !${apData>/busy} &amp;&amp; !${apData>/upload/watching} }"/>
					<Button text="Open desk" icon="sap-icon://table-view" press="onGoDesk"
						class="apGhostButton sapUiTinyMarginEnd"/>
					<Button text="Approval queue ({= ${apData>/approvals}.length })" icon="sap-icon://approvals"
						press="onGoQueue" visible="{apData>/permissions/approver}" class="apGhostButton"/>
				</HBox>
			</HBox>
			<!-- Home intake: upload starts here; hides while green theater is live -->
			<VBox id="homeDropZone" class="apHeroDrop apHeroDrop--home sapUiMediumMarginBottom"
				alignItems="Center" justifyContent="Center"
				visible="{= ${apData>/permissions/processor} &amp;&amp; !${apData>/upload/watching} }">
				<VBox alignItems="Center" class="apHeroDropInner">
					<VBox class="apHeroDropBadge sapUiTinyMarginBottom" alignItems="Center" justifyContent="Center">
						<core:Icon src="sap-icon://add-document" size="1.5rem" class="apHeroDropIcon"/>
					</VBox>
					<Title text="Drop invoice to start" level="H3" class="apHeroDropTitle"/>
					<Text text="or browse — PDF, up to 25 MB. Watch the full pipeline on this page."
						class="apHeroDropHint sapUiTinyMarginTop sapUiSmallMarginBottom"/>
					<u:FileUploader id="homeFileUploader" fileType="pdf" sameFilenameAllowed="true"
						buttonOnly="true" buttonText="Browse files" tooltip="Choose a PDF invoice"
						style="Emphasized" change="onHomeUploadChange"
						enabled="{= !${apData>/busy} &amp;&amp; !${apData>/upload/watching} }"
						class="apHeroDropBrowse"/>
					<HBox class="apHeroDropFormats sapUiTinyMarginTop" wrap="Wrap" justifyContent="Center">
						<ObjectStatus text="PDF" inverted="true" class="apFormatChip"/>
					</HBox>
				</VBox>
				<VBox visible="{apData>/busy}" class="apHeroDropBusy" alignItems="Center" justifyContent="Center">
					<VBox class="apUploadSpinnerRing"/>
					<Text text="{apData>/upload/fileName}" class="apHeroDropBusyFile sapUiSmallMarginTop"/>
					<Text text="Receiving your file…" class="apHeroDropBusyLabel sapUiTinyMarginTop"/>
				</VBox>
			</VBox>
			<!-- Green process theater: stays until Review or Dismiss — not auto-hidden when agents finish -->
			<VBox visible="{apData>/upload/watching}" class="apPipeHero apPipeHero--home sapUiMediumMarginBottom">
				<HBox alignItems="Center" justifyContent="SpaceBetween" wrap="Wrap" class="apPipeHeroHeader sapUiTinyMarginBottom">
					<VBox>
						<HBox alignItems="Center" class="sapUiTinyMarginBottom">
							<VBox class="apPipeNowDot sapUiTinyMarginEnd"/>
							<Text text="Full pipeline · live" class="apPipeHeroKicker"/>
						</HBox>
						<Title text="Watch the complete cycle" level="H3" class="apPipeHeroTitle"/>
						<Text text="{apData>/upload/fileName}" class="apPipeHeroFile sapUiTinyMarginTop"/>
					</VBox>
					<HBox alignItems="Center" visible="{= !!${apData>/upload/result} }" class="apUploadActions">
						<Button text="Dismiss" icon="sap-icon://decline" press="onDismissHomePipeline"
							class="apLightButton sapUiTinyMarginEnd"/>
						<Button text="Review invoice" icon="sap-icon://inspect" type="Emphasized" press="onReviewHomePipeline"
							visible="{= ${apData>/upload/result} === 'ready' }"/>
						<Button text="Needs review" icon="sap-icon://alert" type="Attention" press="onReviewHomePipeline"
							visible="{= ${apData>/upload/result} === 'review' }"/>
					</HBox>
				</HBox>
				<HBox class="apPipeTrack" renderType="Bare" items="{apData>/uploadSteps}">
					<VBox class="apPipeTrackStep" alignItems="Center">
						<customData>
							<core:CustomData key="state" value="{apData>state}" writeToDom="true"/>
						</customData>
						<VBox class="apPipeTrackDot" alignItems="Center" justifyContent="Center">
							<core:Icon src="{apData>icon}" size="1rem"/>
						</VBox>
						<Text text="{apData>title}" class="apPipeTrackLabel sapUiTinyMarginTop" textAlign="Center"/>
						<Text text="{apData>service}" class="apPipeTrackService" textAlign="Center"
							visible="{= !!${apData>service} }"/>
						<ObjectStatus text="{apData>statusLabel}" class="apStepStatus sapUiTinyMarginTop"/>
					</VBox>
				</HBox>
				<HBox visible="{= !!${apData>/upload/nowText} }" alignItems="Center" class="apPipeNow sapUiSmallMarginTop">
					<VBox class="apPipeNowDot sapUiTinyMarginEnd"/>
					<Text text="{apData>/upload/nowText}" class="apPipeNowText"/>
				</HBox>
				<ProgressIndicator class="apPipeProgress sapUiTinyMarginTop"
					percentValue="{apData>/upload/progressPercent}"
					displayValue="{apData>/upload/progressPercent}% complete"
					state="Information" showValue="true"/>
			</VBox>
			<!-- After pipeline finishes: Clear Desk stays on Home under the green theater -->
			<VBox id="homeReviewAnchor"
				visible="{= !!${apData>/upload/result} &amp;&amp; ${apData>/upload/homeReview} &amp;&amp; ${apData>/selectedInvoice/hasCase} }"
				class="apHomeReview sapUiMediumMarginBottom">
				<Title text="Review invoice" level="H4" class="apSectionTitle sapUiTinyMarginBottom"/>
				<Text text="PDF, fields, and decide actions — still on Home under the pipeline."
					class="apTimelineMeta sapUiTinyMarginBottom"/>
				<mvc:XMLView id="homeReviewPanel" viewName="saudicargo.ap.automation.view.ReviewPanel"
					height="42rem" class="apReviewShell--home"/>
			</VBox>
			<!-- One-click path to Desk (KPIs + Cases board) -->
			<HBox class="apDeskJump sapUiMediumMarginBottom" alignItems="Center" justifyContent="SpaceBetween" wrap="Wrap">
				<VBox>
					<Title text="Invoice desk" level="H4" class="apSectionTitle"/>
					<Text text="KPIs, filters, and the full cases board live on Desk."
						class="apTimelineMeta sapUiTinyMarginTop"/>
				</VBox>
				<HBox alignItems="Center" wrap="Wrap" class="sapUiSmallMarginTopBottom">
					<Button text="{apData>/deskLink/chipText}" icon="sap-icon://alert"
						press="onGoDesk" type="Attention" class="apDeskAttention sapUiTinyMarginEnd"
						visible="{apData>/deskLink/attention}"/>
					<Button text="{apData>/deskLink/openText}" icon="sap-icon://table-view"
						press="onGoDesk" type="Emphasized" class="apDeskOpen"/>
				</HBox>
			</HBox>
		</VBox>
	</Page>
</mvc:View>
