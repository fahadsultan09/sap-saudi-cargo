<mvc:View
	controllerName="saudicargo.ap.automation.controller.Dashboard"
	xmlns:mvc="sap.ui.core.mvc"
	xmlns="sap.m"
	xmlns:core="sap.ui.core">
	<Page showHeader="false" backgroundDesign="Transparent" class="apSection">
		<VBox class="sapUiMediumMargin">
			<HBox class="apWelcome sapUiMediumMarginBottom" alignItems="Center"
				justifyContent="SpaceBetween" wrap="Wrap">
				<VBox>
					<Text text="AP Console · AP Automation" class="apWelcomeBrand"/>
					<Title text="{apData>/welcome/greeting}" level="H2"/>
					<Text text="{apData>/welcome/subtitle}" class="sapUiTinyMarginTop"/>
				</VBox>
				<HBox class="sapUiSmallMarginTopBottom">
					<Button text="Upload invoice" icon="sap-icon://upload" press="onGoUpload"
						visible="{apData>/permissions/processor}" class="apLightButton sapUiSmallMarginEnd"/>
					<Button text="Approval queue ({= ${apData>/approvals}.length })" icon="sap-icon://approvals"
						press="onGoQueue" visible="{apData>/permissions/approver}" class="apGhostButton"/>
				</HBox>
			</HBox>
			<core:Fragment fragmentName="saudicargo.ap.automation.view.fragments.KpiStrip" type="XML"/>
			<VBox class="apCaseBoard">
				<HBox alignItems="Center" justifyContent="SpaceBetween" wrap="Wrap" class="apCaseBoardHeader">
					<Title text="Cases" level="H3" class="apSectionTitle"/>
					<HBox alignItems="Center">
						<HBox items="{apData>/filterOptions}" wrap="Wrap" class="apFilter sapUiTinyMarginEnd">
							<ToggleButton text="{apData>text}" pressed="{= ${apData>key} === ${apData>/statusFilter} }"
								press="onStatusFilterPress" class="apFilterPill"/>
						</HBox>
						<Button icon="sap-icon://refresh" type="Transparent" tooltip="Refresh" press="onRefreshCases"/>
					</HBox>
				</HBox>
				<MessageStrip text="{apData>/queueWarning}" type="Warning" showIcon="true"
					visible="{= !!${apData>/queueWarning} }" class="sapUiSmallMarginBottom"/>
				<VBox visible="{= !!${apData>/pipelineBanner} }" class="apPipelineBanner sapUiSmallMarginBottom">
					<HBox alignItems="Center" wrap="Wrap" class="sapUiTinyMarginBottom">
						<VBox class="apPipeNowDot sapUiTinyMarginEnd"/>
						<core:Icon src="sap-icon://process" size="0.875rem" class="apReasonIcon sapUiTinyMarginEnd"/>
						<Text text="{apData>/pipelineBanner}" wrapping="true"/>
					</HBox>
					<HBox class="apPipeMini" alignItems="Center" items="{apData>/pipelineBannerDots}">
						<HBox alignItems="Center" class="apPipeMiniItem">
							<customData>
								<core:CustomData key="state" value="{apData>state}" writeToDom="true"/>
							</customData>
							<VBox class="apPipeMiniDot"/>
							<Text text="{apData>short}" class="apPipeMiniLabel"/>
							<VBox class="apPipeMiniConnector"/>
						</HBox>
					</HBox>
				</VBox>
				<Table items="{apData>/pagedCases}" fixedLayout="false" class="apTable">
					<noData>
						<IllustratedMessage illustrationType="sapIllus-NoEntries" illustrationSize="Spot"
							title="No cases here yet" description="{= ${apData>/permissions/processor} ? 'Upload an invoice to start, or change the status filter.' : 'No invoices match this status filter yet.' }"/>
					</noData>
					<columns>
						<Column><Text text="Invoice" wrapping="false"/></Column>
						<Column minScreenWidth="Tablet" demandPopin="true"><Text text="Supplier" wrapping="false"/></Column>
						<Column hAlign="End" width="8rem"><Text text="Amount" wrapping="false"/></Column>
						<Column hAlign="Center" width="9rem"><Text text="Status" wrapping="false"/></Column>
						<Column minScreenWidth="Tablet" demandPopin="true" importance="Low">
							<Text text="Created ({apData>/timeZoneLabel})" wrapping="false"/>
						</Column>
					</columns>
					<items>
						<ColumnListItem type="Navigation" press="onCasePress">
							<cells>
								<VBox>
									<ObjectIdentifier title="{apData>id}"/>
									<HBox visible="{= !!${apData>processing} }" class="apPipeMini apPipeMini--row sapUiTinyMarginTop"
										alignItems="Center" items="{apData>pipelineDots}">
										<HBox alignItems="Center" class="apPipeMiniItem">
											<customData>
												<core:CustomData key="state" value="{apData>state}" writeToDom="true"/>
											</customData>
											<VBox class="apPipeMiniDot" tooltip="{apData>title}"/>
											<VBox class="apPipeMiniConnector"/>
										</HBox>
									</HBox>
									<Text text="{apData>pipelineHint}" class="apPipelineHint"
										visible="{= !!${apData>pipelineHint} }"/>
								</VBox>
								<Text text="{apData>supplier}"/>
								<Text text="{apData>amount}" class="apAmount"/>
								<ObjectStatus text="{apData>status}" state="{apData>state}" inverted="true"
									icon="{= ${apData>processing} ? 'sap-icon://synchronize' : '' }">
									<customData>
										<core:CustomData key="processing" value="{= String(${apData>processing}) }" writeToDom="true"/>
									</customData>
								</ObjectStatus>
								<Text text="{apData>date} "/>
							</cells>
						</ColumnListItem>
					</items>
				</Table>
				<HBox visible="{= ${apData>/cases}.length > 0 }" alignItems="Center" justifyContent="SpaceBetween"
					class="apPager">
					<Text text="{apData>/page/range}" class="apTimelineMeta"/>
					<HBox alignItems="Center">
						<Button icon="sap-icon://navigation-left-arrow" type="Transparent" tooltip="Previous page"
							press="onPreviousPage" enabled="{= ${apData>/page/index} > 0 }"/>
						<Text text="{apData>/page/text}" class="apPagerText"/>
						<Button icon="sap-icon://navigation-right-arrow" type="Transparent" tooltip="Next page"
							press="onNextPage" enabled="{= ${apData>/page/index} &lt; ${apData>/page/count} - 1 }"/>
					</HBox>
				</HBox>
			</VBox>
		</VBox>
	</Page>
</mvc:View>
