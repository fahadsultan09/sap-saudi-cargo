<mvc:View
	controllerName="saudicargo.ap.automation.controller.Upload"
	xmlns:mvc="sap.ui.core.mvc"
	xmlns="sap.m"
	xmlns:core="sap.ui.core"
	xmlns:u="sap.ui.unified">
	<Page showHeader="false" backgroundDesign="Transparent" class="apSection apUploadPage">
		<VBox class="sapUiLargeMargin apUploadWrap">
			<HBox alignItems="Center" class="apUploadKicker sapUiTinyMarginBottom">
				<core:Icon src="sap-icon://flight" size="0.75rem" class="sapUiTinyMarginEnd"/>
				<Text text="Runway intake · one invoice at a time"/>
			</HBox>
			<Title text="Start the AP pipeline" level="H2" class="apSectionTitle apUploadTitle sapUiTinyMarginBottom"/>
			<Text text="Drop a file and watch the full cycle light up: Received → Classify (TOWER) → Extract (LENS) → Finance rules → Clear Desk."
				class="apUploadLead sapUiMediumMarginBottom"
				visible="{= !${apData>/upload/watching} }"/>

			<HBox class="apUploadGrid" alignItems="Stretch" wrap="Wrap"
				visible="{= !${apData>/upload/watching} }">
				<VBox id="dropZone" class="apHeroDrop" alignItems="Center" justifyContent="Center">
					<VBox alignItems="Center" class="apHeroDropInner">
						<VBox class="apHeroDropBadge sapUiTinyMarginBottom" alignItems="Center" justifyContent="Center">
							<core:Icon src="sap-icon://add-document" size="1.75rem" class="apHeroDropIcon"/>
						</VBox>
						<Title text="Drop invoice to start" level="H3" class="apHeroDropTitle"/>
						<Text text="or browse — PDF, up to 25 MB" class="apHeroDropHint sapUiTinyMarginTop sapUiSmallMarginBottom"/>
						<u:FileUploader id="fileUploader" fileType="pdf" sameFilenameAllowed="true"
							buttonOnly="true" buttonText="Browse files" tooltip="Choose a PDF invoice"
							style="Emphasized" change="onUploadChange"
							enabled="{= !${apData>/busy} &amp;&amp; !${apData>/upload/watching} }" class="apHeroDropBrowse"/>
						<HBox class="apHeroDropFormats sapUiTinyMarginTop" wrap="Wrap" justifyContent="Center">
							<ObjectStatus text="PDF" inverted="true" class="apFormatChip"/>
						</HBox>
					</VBox>
					<VBox visible="{apData>/busy}" class="apHeroDropBusy" alignItems="Center" justifyContent="Center">
						<VBox class="apUploadSpinnerRing"/>
						<Text text="{apData>/upload/fileName}" class="apHeroDropBusyFile sapUiSmallMarginTop"/>
						<Text text="Receiving your file…" class="apHeroDropBusyLabel sapUiTinyMarginTop"/>
					</VBox>
				</VBox>

				<VBox class="apUploadSteps apPipeRail">
					<Text text="Full pipeline" class="apUploadStepsLabel sapUiTinyMarginBottom"/>
					<Text text="All five steps stay on screen. After upload they light Done / Working / Pending live."
						class="apUploadStepsHint sapUiTinyMarginBottom"/>
					<VBox items="{apData>/uploadSteps}" class="apStepList apPipeRailList">
						<HBox alignItems="Start" class="apStep">
							<customData>
								<core:CustomData key="state" value="{apData>state}" writeToDom="true"/>
							</customData>
							<VBox class="apStepDot" alignItems="Center" justifyContent="Center">
								<core:Icon src="{apData>icon}" size="0.85rem"/>
							</VBox>
							<VBox class="apStepBody sapUiTinyMarginBegin">
								<HBox alignItems="Center" justifyContent="SpaceBetween" wrap="Wrap" class="apStepTitleRow">
									<Text text="{apData>title}" class="apStepTitle"/>
									<ObjectStatus text="{apData>statusLabel}" class="apStepStatus"/>
								</HBox>
								<Text text="{apData>service}" class="apStepService"
									visible="{= !!${apData>service} }"/>
								<Text text="{apData>description}" class="apStepText"/>
							</VBox>
						</HBox>
					</VBox>
				</VBox>
			</HBox>

			<VBox visible="{apData>/upload/watching}" class="apPipeHero apPipeHero--upload">
				<HBox alignItems="Center" justifyContent="SpaceBetween" wrap="Wrap" class="apPipeHeroHeader sapUiTinyMarginBottom">
					<VBox>
						<HBox alignItems="Center" class="sapUiTinyMarginBottom">
							<VBox class="apPipeNowDot sapUiTinyMarginEnd"/>
							<Text text="Full pipeline · live" class="apPipeHeroKicker"/>
						</HBox>
						<Title text="Watch the complete cycle" level="H3" class="apPipeHeroTitle"/>
						<Text text="{apData>/upload/fileName}" class="apPipeHeroFile sapUiTinyMarginTop"/>
					</VBox>
					<Button text="Open Clear Desk now" type="Emphasized" icon="sap-icon://inspect"
						visible="{= !!${apData>/upload/caseId} }" press="onOpenLiveCase"/>
				</HBox>

				<HBox class="apPipeTrack" wrap="Wrap" justifyContent="SpaceBetween"
					items="{apData>/uploadSteps}">
					<VBox class="apPipeTrackStep" alignItems="Center">
						<customData>
							<core:CustomData key="state" value="{apData>state}" writeToDom="true"/>
						</customData>
						<VBox class="apPipeTrackDot" alignItems="Center" justifyContent="Center">
							<core:Icon src="{apData>icon}" size="1rem"/>
						</VBox>
						<Text text="{apData>title}" class="apPipeTrackLabel sapUiTinyMarginTop" textAlign="Center"/>
						<Text text="{apData>service}" class="apPipeTrackService" textAlign="Center"
							visible="{= !!${apData>service} }"/>
						<ObjectStatus text="{apData>statusLabel}" class="apStepStatus sapUiTinyMarginTop"/>
					</VBox>
				</HBox>

				<HBox visible="{= !!${apData>/upload/nowText} }" alignItems="Center" class="apPipeNow sapUiSmallMarginTop">
					<VBox class="apPipeNowDot sapUiTinyMarginEnd"/>
					<Text text="{apData>/upload/nowText}" class="apPipeNowText"/>
				</HBox>
				<ProgressIndicator class="apPipeProgress sapUiTinyMarginTop"
					percentValue="{apData>/upload/progressPercent}"
					displayValue="{apData>/upload/progressPercent}% complete"
					state="Information" showValue="true"/>
			</VBox>

			<ObjectStatus text="{apData>/upload/message}" state="{apData>/upload/state}" inverted="true"
				visible="{apData>/upload/visible}" class="apUploadStatus"/>
		</VBox>
	</Page>
</mvc:View>
