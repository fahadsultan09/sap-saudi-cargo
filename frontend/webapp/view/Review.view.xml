<mvc:View
	controllerName="saudicargo.ap.automation.controller.Review"
	xmlns:mvc="sap.ui.core.mvc"
	xmlns="sap.m"
	xmlns:core="sap.ui.core"
	xmlns:html="http://www.w3.org/1999/xhtml">
	<Page showHeader="false" backgroundDesign="Transparent" class="apSection">
		<Toolbar style="Clear" visible="{apData>/selectedInvoice/hasCase}">
			<Button text="Back to cases" icon="sap-icon://nav-back" type="Transparent" press="onNavBack"
				class="apBackLink"/>
		</Toolbar>
		<IllustratedMessage visible="{= !${apData>/selectedInvoice/hasCase} }"
			illustrationType="sapIllus-NoTasks" illustrationSize="Scene"
			title="Clear Desk is empty" description="Open a case from the Dashboard or upload an invoice to review it here."/>
		<VBox height="calc(100vh - 7.5rem)" visible="{apData>/selectedInvoice/hasCase}" class="apReviewShell apReviewShell--docked">
			<HBox class="apReviewSplit" height="100%">
				<layoutData>
					<FlexItemData growFactor="1" baseSize="0" minHeight="0"/>
				</layoutData>
				<VBox class="apPdfPane" height="100%">
					<layoutData>
						<FlexItemData growFactor="1" baseSize="0" minWidth="0" minHeight="70vh"/>
					</layoutData>
					<HBox class="apPdfPaneHeader" alignItems="Center" justifyContent="SpaceBetween">
						<layoutData>
							<FlexItemData growFactor="0" shrinkFactor="0"/>
						</layoutData>
						<Text text="Invoice document"/>
						<Button text="Open" icon="sap-icon://inspect-open" type="Transparent"
							press="onOpenDocument" enabled="{= !!${apData>/selectedInvoice/documentUrl} }"/>
					</HBox>
					<VBox class="apPdfPaneBody" height="100%">
						<layoutData>
							<FlexItemData growFactor="1" baseSize="0" minHeight="0"/>
						</layoutData>
						<html:iframe id="invoicePdfFrame" class="apPdfFrame" title="Invoice document preview"
							src="{apData>/selectedInvoice/documentUrl}"/>
						<VBox visible="{= !${apData>/selectedInvoice/documentUrl} }" alignItems="Center"
							justifyContent="Center" class="apPdfEmpty">
							<IllustratedMessage illustrationType="sapIllus-NoData" illustrationSize="Spot"
								title="Document loading" description="The invoice PDF appears here when available."/>
						</VBox>
					</VBox>
				</VBox>
				<VBox class="apReviewMain" height="100%">
					<layoutData>
						<FlexItemData growFactor="1" baseSize="0" minWidth="0"/>
					</layoutData>
					<HBox class="apReviewHeader" alignItems="Center" justifyContent="SpaceBetween" wrap="Wrap">
						<VBox>
							<Title text="{apData>/selectedInvoice/supplier}" level="H3"/>
							<HBox alignItems="Center" class="sapUiTinyMarginTop" wrap="Wrap">
								<Text text="Invoice: {apData>/selectedInvoice/id}" class="sapUiMediumMarginEnd"/>
								<ObjectStatus text="{apData>/selectedInvoice/status}"
									state="{apData>/selectedInvoice/statusState}" inverted="true" class="sapUiMediumMarginEnd"/>
								<Text text="Uploaded by {apData>/selectedInvoice/createdBy} · Last edited by {apData>/selectedInvoice/editedBy}"
									class="apTimelineMeta"/>
							</HBox>
						</VBox>
						<Button text="Save corrections" icon="sap-icon://save" type="Emphasized"
							press="onSaveCorrections" visible="{apData>/selectedInvoice/canEdit}"/>
					</HBox>
					<IconTabBar id="reviewTabs" class="apReviewTabs apIconTabFade" expandable="false" applyContentPadding="false"
						select="onReviewTabSelect" selectedKey="{apData>/reviewTabKey}">
						<layoutData>
							<FlexItemData growFactor="1" baseSize="0" minHeight="0"/>
						</layoutData>
						<items>
							<IconTabFilter text="Agent Results" key="agents">
								<ScrollContainer height="100%" vertical="true" horizontal="false" class="apReviewBody">
									<VBox>
										<VBox visible="{apData>/selectedInvoice/isProcessing}" class="apPipeHero apPipeHero--review sapUiSmallMarginBottom">
											<HBox alignItems="Center" class="sapUiTinyMarginBottom">
												<VBox class="apPipeNowDot sapUiTinyMarginEnd"/>
												<Title text="Full pipeline · agents at work" level="H5" class="apPipeLiveTitle"/>
											</HBox>
											<Text text="Every step stays on screen — Done, Working, and still Pending."
												class="apUploadStepsHint sapUiTinyMarginBottom"/>
											<VBox items="{apData>/selectedInvoice/pipelineSteps}" class="apStepList apPipeRailList">
												<HBox alignItems="Start" class="apStep">
													<customData>
														<core:CustomData key="state" value="{apData>state}" writeToDom="true"/>
														<core:CustomData key="tone" value="{apData>tone}" writeToDom="true"/>
													</customData>
													<VBox class="apStepDot" alignItems="Center" justifyContent="Center">
														<core:Icon src="{apData>icon}" size="0.85rem"/>
													</VBox>
													<VBox class="apStepBody sapUiTinyMarginBegin">
														<HBox alignItems="Center" justifyContent="SpaceBetween" wrap="Wrap" class="apStepTitleRow">
															<Text text="{apData>title}" class="apStepTitle"/>
															<ObjectStatus text="{apData>statusLabel}" class="apStepStatus"/>
														</HBox>
														<Text text="{apData>service}" class="apStepService"
															visible="{= !!${apData>service} }"/>
														<Text text="{apData>description}" class="apStepText"/>
														<Text text="{apData>meta}" class="apTimelineMeta"
															visible="{= !!${apData>meta} }"/>
													</VBox>
												</HBox>
											</VBox>
											<HBox visible="{= !!${apData>/selectedInvoice/pipelineNow} }"
												alignItems="Center" class="apPipeNow sapUiSmallMarginTop">
												<VBox class="apPipeNowDot sapUiTinyMarginEnd"/>
												<Text text="{apData>/selectedInvoice/pipelineNow}" class="apPipeNowText"/>
											</HBox>
											<ProgressIndicator class="apPipeProgress sapUiTinyMarginTop"
												percentValue="{apData>/selectedInvoice/pipelinePercent}"
												displayValue="{apData>/selectedInvoice/pipelineSummary}"
												state="Information" showValue="true"/>
										</VBox>

										<VBox visible="{= ${apData>/selectedInvoice/reviewReasons}.length > 0 }"
											class="apReasonCard sapUiSmallMarginBottom">
											<Title text="Why this invoice needs attention" level="H5" class="apReasonTitle"/>
											<VBox items="{apData>/selectedInvoice/reviewReasons}">
												<HBox alignItems="Center" class="apReasonItem">
													<core:Icon src="{apData>icon}" class="apReasonIcon"/>
													<Text text="{apData>text}"/>
												</HBox>
											</VBox>
										</VBox>
										<HBox class="sapUiSmallMarginBottom" wrap="Wrap">
											<ObjectStatus title="Document type" text="{apData>/selectedInvoice/documentType}" class="sapUiLargeMarginEnd"/>
											<ObjectStatus title="Classification confidence" text="{apData>/selectedInvoice/classificationConfidence}" class="sapUiLargeMarginEnd"/>
											<ObjectStatus title="Agent mode" text="{apData>/selectedInvoice/agentMode}"/>
										</HBox>

										<VBox visible="{= !${apData>/selectedInvoice/isProcessing} }" class="apPipeRail sapUiTinyMarginBottom">
											<Title text="Pipeline" level="H5" class="apSectionTitle sapUiTinyMarginBottom"/>
											<Text text="Received → Classify (TOWER) → Extract (LENS) → Finance rules → Clear Desk / Dock Decide."
												class="apTimelineMeta sapUiTinyMarginBottom"/>
											<VBox items="{apData>/selectedInvoice/pipelineSteps}" class="apStepList apPipeRailList">
												<HBox alignItems="Start" class="apStep">
													<customData>
														<core:CustomData key="state" value="{apData>state}" writeToDom="true"/>
														<core:CustomData key="tone" value="{apData>tone}" writeToDom="true"/>
													</customData>
													<VBox class="apStepDot" alignItems="Center" justifyContent="Center">
														<core:Icon src="{apData>icon}" size="0.85rem"/>
													</VBox>
													<VBox class="apStepBody sapUiTinyMarginBegin">
														<HBox alignItems="Center" justifyContent="SpaceBetween" wrap="Wrap" class="apStepTitleRow">
															<Text text="{apData>title}" class="apStepTitle"/>
															<ObjectStatus text="{apData>statusLabel}" class="apStepStatus"/>
														</HBox>
														<Text text="{apData>service}" class="apStepService"
															visible="{= !!${apData>service} }"/>
														<Text text="{apData>description}" class="apStepText"/>
														<Text text="{apData>meta}" class="apTimelineMeta"
															visible="{= !!${apData>meta} }"/>
													</VBox>
												</HBox>
											</VBox>
										</VBox>

										<Title text="Checks" level="H5" class="apSectionTitle sapUiSmallMarginTop sapUiTinyMarginBottom"/>
										<HBox wrap="Wrap" class="apChips sapUiSmallMarginBottom" items="{apData>/selectedInvoice/checks}">
											<ObjectStatus text="{apData>name}: {apData>value}" state="{apData>state}" inverted="true"/>
										</HBox>
										<Title text="Findings" level="H5" class="apSectionTitle sapUiSmallMarginTop sapUiTinyMarginBottom"/>
										<List items="{apData>/selectedInvoice/findings}" noDataText="No findings">
											<StandardListItem title="{apData>text}" icon="{apData>icon}" wrapping="true"/>
										</List>
									</VBox>
								</ScrollContainer>
							</IconTabFilter>
							<IconTabFilter text="Invoice Fields" key="fields">
								<ScrollContainer height="100%" vertical="true" horizontal="false" class="apReviewBody">
									<Table items="{apData>/selectedInvoice/fields}" fixedLayout="false" class="apTable apFieldsTable">
									<headerToolbar>
										<OverflowToolbar visible="{= !!${apData>/selectedInvoice/fieldsGuidance} }">
											<core:Icon src="sap-icon://hint" size="0.875rem" class="apReasonIcon sapUiTinyMarginEnd"/>
											<Text text="{apData>/selectedInvoice/fieldsGuidance}" wrapping="true"/>
										</OverflowToolbar>
									</headerToolbar>
										<columns>
											<Column><Text text="Field"/></Column>
											<Column><Text text="Value"/></Column>
										</columns>
										<items>
											<ColumnListItem>
												<cells>
													<Text text="{apData>field}"/>
													<Input value="{apData>value}" editable="{apData>/selectedInvoice/canEdit}"
														valueState="{= ${apData>needsAttention} ? 'Warning' : 'None' }"
														valueStateText="Required before approval"/>
												</cells>
											</ColumnListItem>
										</items>
									</Table>
								</ScrollContainer>
							</IconTabFilter>
						</items>
					</IconTabBar>
				</VBox>
			</HBox>
			<core:Fragment fragmentName="saudicargo.ap.automation.view.fragments.DecisionBar" type="XML"/>
		</VBox>
	</Page>
</mvc:View>
