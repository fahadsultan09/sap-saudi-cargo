<mvc:View
	controllerName="saudicargo.ap.automation.controller.Review"
	xmlns:mvc="sap.ui.core.mvc"
	xmlns="sap.m">
	<Page showHeader="false" backgroundDesign="Transparent" class="apSection">
		<Toolbar style="Clear" visible="{apData>/selectedInvoice/hasCase}" class="apBackBar">
			<Button text="Back to dashboard" icon="sap-icon://nav-back" type="Transparent" press="onNavBack"
				class="apBackLink"/>
		</Toolbar>
		<IllustratedMessage visible="{= !${apData>/selectedInvoice/hasCase} }"
			illustrationType="sapIllus-NoTasks" illustrationSize="Scene"
			title="No invoice open" description="{= ${apData>/permissions/processor} ? 'Open an invoice from the list on Home, or upload one, to review it here.' : 'Open an invoice from the list on Home to review it here.' }"/>
		<mvc:XMLView id="reviewRoutePanel" viewName="saudicargo.ap.automation.view.ReviewPanel"
			visible="{apData>/selectedInvoice/hasCase}" class="apReviewShell--route"/>
	</Page>
</mvc:View>
