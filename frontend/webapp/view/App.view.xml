<mvc:View
    controllerName="saudicargo.ap.automation.controller.App"
	xmlns:mvc="sap.ui.core.mvc"
	xmlns="sap.m"
	xmlns:tnt="sap.tnt">
	<Shell id="shell" appWidthLimited="false">
		<App id="app">
			<pages>
				<tnt:ToolPage id="toolPage" class="apPage">
					<tnt:header>
						<tnt:ToolHeader class="apHeader">
							<Button icon="sap-icon://menu2" type="Transparent" press="onToggleSideNav"
								tooltip="Show or hide the menu" class="apMenuButton"/>
							<HBox alignItems="Center">
								<Image src="img/saudia-cargo-logo.png" alt="Saudia Cargo" height="2.25rem" class="apLogo"/>
								<VBox class="apBrandText">
									<Title text="Accounts Payable" level="H4" class="apBrandTitle"/>
									<Text text="Invoice automation" wrapping="false" class="apBrandSubtitle"/>
								</VBox>
							</HBox>
							<ToolbarSpacer/>
							<HBox alignItems="Center">
								<VBox alignItems="End" class="sapUiSmallMarginEnd">
									<Text text="{apData>/currentUser/name}" wrapping="false" class="apHeaderName"/>
									<Text text="{apData>/currentUser/roleLabel}" wrapping="false" class="apHeaderRole"/>
								</VBox>
								<Avatar initials="{apData>/currentUser/initials}" displaySize="XS"
									backgroundColor="{apData>/currentUser/avatarColor}" press="onOpenProfileMenu"
									tooltip="Profile" ariaHasPopup="Menu" class="apProfileAvatar"/>
							</HBox>
						</tnt:ToolHeader>
					</tnt:header>
					<tnt:sideContent>
						<tnt:SideNavigation selectedKey="{apData>/section}" itemSelect="onSectionSelect" class="apSideNav">
							<tnt:NavigationList>
								<!-- Upload and the approval queue open from the dashboard's welcome banner. -->
								<tnt:NavigationListItem key="dashboard" text="Dashboard" icon="sap-icon://bbyd-dashboard"/>
								<tnt:NavigationListItem key="review" text="Invoice Review" icon="sap-icon://inspect"/>
								<tnt:NavigationListItem key="audit" text="Audit Trail" icon="sap-icon://history"/>
							</tnt:NavigationList>
						</tnt:SideNavigation>
					</tnt:sideContent>
					<tnt:mainContents>
						<!-- The router places one screen view at a time in here (see manifest.json routing). -->
						<NavContainer id="sections" defaultTransitionName="show"/>
					</tnt:mainContents>
				</tnt:ToolPage>
			</pages>
		</App>
	</Shell>
</mvc:View>
