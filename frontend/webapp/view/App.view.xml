<mvc:View
    controllerName="saudicargo.ap.automation.controller.App"
	xmlns:mvc="sap.ui.core.mvc"
	xmlns="sap.m"
	xmlns:l="sap.ui.layout"
	xmlns:uxap="sap.uxap"
	xmlns:core="sap.ui.core"
	xmlns:u="sap.ui.unified">
	<Shell id="shell">
		<App id="app">
			<pages>
				<Page id="mainPage" titleAlignment="Start">
					<customHeader>
						<Bar design="Header">
							<contentLeft>
								<HBox alignItems="Center">
									<Avatar src="sap-icon://shipping-status" displayShape="Square" displaySize="S"
										backgroundColor="Accent6" class="sapUiTinyMarginEnd"/>
									<VBox>
										<Title text="Accounts Payable Automation" level="H4"/>
										<Text text="Saudi Cargo" wrapping="false"/>
									</VBox>
								</HBox>
							</contentLeft>
							<contentMiddle>
								<ObjectStatus text="AI-Powered Invoice Processing" icon="sap-icon://ai" state="Information"/>
							</contentMiddle>
							<contentRight>
								<Label text="Signed in as" labelFor="userSelect"/>
								<Select id="userSelect" selectedKey="{config>/currentUserId}" items="{config>/users}"
									enabled="{= !${apData>/busy} }"
									change="onUserChange" width="14rem">
									<core:Item key="{config>id}" text="{config>name} ({config>role})"/>
								</Select>
							</contentRight>
						</Bar>
					</customHeader>
					<content>
						<IconTabBar id="idIconTabBar" headerBackgroundDesign="Solid" expandable="false" select="onTabSelect">
							<items>
								<!-- Screen 1 — Dashboard and case worklist -->
								<IconTabFilter key="dashboard" text="Dashboard" icon="sap-icon://bbyd-dashboard">
									<VBox class="sapUiMediumMargin">
										<Title text="Key Performance Indicators" level="H3" class="sapUiSmallMarginBottom"/>
										<HBox wrap="Wrap" class="sapUiSmallMarginBottom">
											<GenericTile header="Total Invoices" class="sapUiTinyMarginEnd">
												<tileContent>
													<TileContent>
														<content>
															<NumericContent value="{apData>/kpis/total}" valueColor="Neutral" withMargin="false"/>
														</content>
													</TileContent>
												</tileContent>
											</GenericTile>
											<GenericTile header="Pending" class="sapUiTinyMarginEnd">
												<tileContent>
													<TileContent>
														<content>
															<NumericContent value="{apData>/kpis/pending}" valueColor="Critical" withMargin="false"/>
														</content>
													</TileContent>
												</tileContent>
											</GenericTile>
											<GenericTile header="Approved" class="sapUiTinyMarginEnd">
												<tileContent>
													<TileContent>
														<content>
															<NumericContent value="{apData>/kpis/approved}" valueColor="Good" withMargin="false"/>
														</content>
													</TileContent>
												</tileContent>
											</GenericTile>
											<GenericTile header="Posted" class="sapUiTinyMarginEnd">
												<tileContent>
													<TileContent>
														<content>
															<NumericContent value="{apData>/kpis/posted}" valueColor="Good" withMargin="false"/>
														</content>
													</TileContent>
												</tileContent>
											</GenericTile>
											<GenericTile header="Rejected" class="sapUiTinyMarginEnd">
												<tileContent>
													<TileContent>
														<content>
															<NumericContent value="{apData>/kpis/rejected}" valueColor="Error" withMargin="false"/>
														</content>
													</TileContent>
												</tileContent>
											</GenericTile>
										</HBox>
										<Table items="{apData>/cases}" noDataText="No cases found" fixedLayout="false">
											<headerToolbar>
												<OverflowToolbar>
													<Title text="Cases" level="H3"/>
													<ToolbarSpacer/>
													<Select selectedKey="{apData>/statusFilter}" items="{apData>/statusOptions}"
														change="onRefreshCases" width="14rem">
														<core:Item key="{apData>key}" text="{apData>text}"/>
													</Select>
													<Button icon="sap-icon://refresh" tooltip="Refresh" press="onRefreshCases"/>
												</OverflowToolbar>
											</headerToolbar>
											<columns>
												<Column><Text text="Invoice"/></Column>
												<Column><Text text="Vendor"/></Column>
												<Column><Text text="Gross"/></Column>
												<Column><Text text="Status"/></Column>
												<Column><Text text="Created"/></Column>
											</columns>
											<items>
												<ColumnListItem type="Navigation" press="onCasePress">
													<cells>
														<ObjectIdentifier title="{apData>id}"/>
														<Text text="{apData>vendor}"/>
														<Text text="{apData>gross}"/>
														<ObjectStatus text="{apData>status}" state="{apData>state}"/>
														<Text text="{apData>date}"/>
													</cells>
												</ColumnListItem>
											</items>
										</Table>
									</VBox>
								</IconTabFilter>
								<!-- Screen 2 — Invoice Upload -->
								<IconTabFilter key="upload" text="Invoice Upload" icon="sap-icon://upload"
									visible="{apData>/permissions/processor}">
									<VBox class="sapUiLargeMargin" alignItems="Center">
										<Title text="Invoice Processing" level="H2" class="sapUiMediumMarginBottom"/>
										<u:FileUploader id="fileUploader" fileType="pdf,png,jpg,jpeg" sameFilenameAllowed="true"
											buttonText="Choose invoice" placeholder="Select a PDF, PNG or JPEG invoice"
											style="Emphasized" width="30rem" change="onUploadChange"
											enabled="{= !${apData>/busy} }"/>
										<Text text="The invoice is uploaded and sent to SAP Document AI as soon as you select it."
											class="sapUiTinyMarginTop"/>
										<VBox id="processingSection" visible="false" class="sapUiLargeMarginTop" width="60%">
											<Text text="Processing status:" class="sapUiTinyMarginBottom"/>
											<ProgressIndicator id="uploadProgress" percentValue="0" state="Information"/>
										</VBox>
									</VBox>
								</IconTabFilter>
								<!-- Screen 3 — Invoice Review -->
								<IconTabFilter key="review" text="Invoice Review" icon="sap-icon://inspect">
									<Toolbar style="Clear" visible="{apData>/selectedInvoice/hasCase}">
										<Button text="Back to cases" icon="sap-icon://nav-back" type="Transparent" press="onNavBack"/>
									</Toolbar>
									<MessageStrip visible="{= !${apData>/selectedInvoice/hasCase} }" type="Information"
										showIcon="true" class="sapUiMediumMargin"
										text="Select a case on the Dashboard or upload an invoice to review it here."/>
									<l:Splitter height="700px" visible="{apData>/selectedInvoice/hasCase}">
										<VBox class="sapUiSmallMargin">
											<layoutData>
												<l:SplitterLayoutData size="40%" minSize="300"/>
											</layoutData>
											<Title text="Original document" level="H4" class="sapUiSmallMarginBottom"/>
											<Panel headerText="{apData>/selectedInvoice/documentFilename}" backgroundDesign="Solid">
												<VBox alignItems="Center" justifyContent="Center" class="sapUiLargeMarginTop sapUiLargeMarginBottom">
													<core:Icon src="sap-icon://pdf-attachment" size="5rem" color="#0a6ed1"/>
													<Text text="Vendor: {apData>/selectedInvoice/vendor}" class="sapUiSmallMarginTop"/>
													<Text text="Confirmed by: {apData>/selectedInvoice/confirmedBy}"/>
													<Text text="Approved by: {apData>/selectedInvoice/approvedBy}"/>
													<Text text="SAP document: {apData>/selectedInvoice/sapDocument}" class="sapUiSmallMarginBottom"/>
													<Button text="Open document" icon="sap-icon://doc-attachment" type="Emphasized"
														press="onOpenDocument" enabled="{= !!${apData>/selectedInvoice/documentUrl} }"
														visible="{apData>/selectedInvoice/hasDocument}"/>
												</VBox>
											</Panel>
										</VBox>
										<!-- Placed directly in the Splitter: the ObjectPage fills its parent and needs a fixed height. -->
										<uxap:ObjectPageLayout id="ObjectPageLayout" showTitleInHeaderContent="true">
											<uxap:layoutData>
												<l:SplitterLayoutData size="60%" minSize="300"/>
											</uxap:layoutData>
												<uxap:headerTitle>
													<uxap:ObjectPageDynamicHeaderTitle>
														<uxap:expandedHeading>
															<Title text="{apData>/selectedInvoice/vendor}" wrapping="true"/>
														</uxap:expandedHeading>
														<uxap:snappedHeading>
															<Title text="{apData>/selectedInvoice/vendor}" wrapping="true"/>
														</uxap:snappedHeading>
														<uxap:expandedContent>
															<HBox alignItems="Center">
																<Text text="Invoice #: {apData>/selectedInvoice/id}" class="sapUiMediumMarginEnd"/>
																<ObjectStatus text="{apData>/selectedInvoice/status}"
																	state="{apData>/selectedInvoice/statusState}" inverted="true"/>
															</HBox>
														</uxap:expandedContent>
														<uxap:actions>
															<Button text="Complete review" icon="sap-icon://complete" type="Emphasized"
																press="onSaveCorrections" visible="{apData>/selectedInvoice/canCompleteReview}"/>
															<Button text="Run agent" icon="sap-icon://ai" type="Emphasized" press="onDecide"
																visible="{apData>/selectedInvoice/canDecide}"/>
															<Button text="Confirm" type="Success" press="onConfirm"
																visible="{apData>/selectedInvoice/canConfirm}"/>
															<Button text="Decide manually" type="Emphasized" press="onDecideManually"
																visible="{apData>/selectedInvoice/canDecideManually}"/>
															<Button text="Resume" icon="sap-icon://restart" press="onResume"
																visible="{apData>/selectedInvoice/canResume}"/>
															<Button text="Approve" type="Success" press="onApproveInvoice"
																visible="{apData>/selectedInvoice/canApprove}"/>
															<Button text="Return" icon="sap-icon://undo" press="onReturnInvoice"
																visible="{apData>/selectedInvoice/canApprove}"/>
															<Button text="Inform vendor" icon="sap-icon://email" press="onInformVendor"
																visible="{apData>/selectedInvoice/canInform}"/>
															<Button text="Reject" type="Reject" press="onRejectInvoice"
																visible="{apData>/selectedInvoice/canReject}"/>
														</uxap:actions>
													</uxap:ObjectPageDynamicHeaderTitle>
												</uxap:headerTitle>
												<uxap:sections>
													<uxap:ObjectPageSection title="Recommendation">
														<uxap:subSections>
															<uxap:ObjectPageSubSection>
																<VBox class="sapUiSmallMargin">
																	<HBox class="sapUiSmallMarginBottom" alignItems="Center">
																		<ObjectStatus title="Recommendation" text="{apData>/selectedInvoice/recommendation}"
																			state="{apData>/selectedInvoice/recommendationState}" class="sapUiLargeMarginEnd"/>
																		<ObjectStatus title="Source" text="{apData>/selectedInvoice/source}" class="sapUiLargeMarginEnd"/>
																		<ObjectStatus title="Agent confidence" text="{apData>/selectedInvoice/confidence}"/>
																	</HBox>
																	<Title text="Reasoning" level="H5" class="sapUiTinyMarginBottom"/>
																	<List items="{apData>/selectedInvoice/reasons}">
																		<StandardListItem title="{apData>text}" icon="{apData>icon}" wrapping="true"/>
																	</List>
																</VBox>
															</uxap:ObjectPageSubSection>
														</uxap:subSections>
													</uxap:ObjectPageSection>
													<uxap:ObjectPageSection title="Invoice Fields">
														<uxap:subSections>
															<uxap:ObjectPageSubSection>
																<Table items="{apData>/selectedInvoice/extractedFields}">
																	<headerToolbar>
																		<OverflowToolbar>
																			<Text text="Fields can be corrected while the case is in review, extracted or returned."
																				visible="{apData>/selectedInvoice/canEdit}"/>
																			<ToolbarSpacer/>
																			<Button text="Save corrections" icon="sap-icon://save" type="Emphasized"
																				press="onSaveCorrections" visible="{apData>/selectedInvoice/canEdit}">
																				<layoutData>
																					<OverflowToolbarLayoutData priority="NeverOverflow"/>
																				</layoutData>
																			</Button>
																		</OverflowToolbar>
																	</headerToolbar>
																	<columns>
																		<Column><Text text="Field"/></Column>
																		<Column><Text text="Value"/></Column>
																		<Column><Text text="Confidence"/></Column>
																	</columns>
																	<items>
																		<ColumnListItem>
																			<cells>
																				<Text text="{apData>field}"/>
																				<Input value="{apData>value}" editable="{apData>/selectedInvoice/canEdit}"
																					valueState="{= ${apData>needsConfirmation} &amp;&amp; ${apData>/selectedInvoice/canEdit} ? 'Warning' : 'None' }"
																					valueStateText="Check this value: missing or low confidence"/>
																				<ObjectStatus text="{apData>confidence}" state="{apData>state}"/>
																			</cells>
																		</ColumnListItem>
																	</items>
																</Table>
															</uxap:ObjectPageSubSection>
														</uxap:subSections>
													</uxap:ObjectPageSection>
												</uxap:sections>
											</uxap:ObjectPageLayout>
									</l:Splitter>
								</IconTabFilter>
								<!-- Screen 4 — Approval Queue -->
								<IconTabFilter key="approvals" text="Approval Queue" icon="sap-icon://approvals"
									count="{= ${apData>/approvals}.length }">
									<VBox class="sapUiMediumMargin">
										<Title text="Invoices awaiting approval" level="H3" class="sapUiSmallMarginBottom"/>
										<Table items="{apData>/approvals}" noDataText="No invoices awaiting approval" fixedLayout="false">
											<columns>
												<Column hAlign="Center"><Text text="Invoice"/></Column>
												<Column hAlign="Center"><Text text="Vendor"/></Column>
												<Column hAlign="Center"><Text text="Gross"/></Column>
												<Column hAlign="Center"><Text text="Recommendation"/></Column>
												<Column hAlign="Center"><Text text="Confirmed by"/></Column>
												<Column visible="{apData>/permissions/approver}" hAlign="Center"><Text text="Actions"/></Column>
											</columns>
											<items>
												<ColumnListItem type="Navigation" press="onCasePress">
													<cells>
														<ObjectIdentifier title="{apData>id}"/>
														<Text text="{apData>vendor}"/>
														<Text text="{apData>gross}"/>
														<Text text="{apData>recommendation}"/>
														<Text text="{apData>confirmedBy}"/>
														<HBox justifyContent="Center" wrap="NoWrap">
															<Button text="Approve" type="Success" class="sapUiTinyMarginEnd" press="onApproveInvoice"/>
															<Button text="Return" class="sapUiTinyMarginEnd" press="onReturnInvoice"/>
															<Button text="Reject" type="Reject" press="onRejectInvoice"/>
														</HBox>
													</cells>
												</ColumnListItem>
											</items>
										</Table>
									</VBox>
								</IconTabFilter>
								<!-- Screen 5 — Audit Trail of the selected case -->
								<IconTabFilter key="audit" text="Audit Trail" icon="sap-icon://history">
									<VBox class="sapUiMediumMargin">
										<Title text="History of invoice {apData>/selectedInvoice/id}" level="H3"
											class="sapUiMediumMarginBottom" visible="{apData>/selectedInvoice/hasCase}"/>
										<List items="{apData>/auditTrail}"
											noDataText="Select a case on the Dashboard to see its history">
											<StandardListItem title="{apData>title}" description="{apData>description}"
												info="{apData>actor} · {apData>time}" icon="sap-icon://activity-items" wrapping="true"/>
										</List>
									</VBox>
								</IconTabFilter>
							</items>
						</IconTabBar>
					</content>
				</Page>
			</pages>
		</App>
	</Shell>
</mvc:View>
