<mvc:View
    controllerName="saudicargo.ap.automation.controller.App"
	xmlns:mvc="sap.ui.core.mvc"
	xmlns="sap.m"
	xmlns:l="sap.ui.layout"
	xmlns:uxap="sap.uxap"
	xmlns:core="sap.ui.core"
	xmlns:u="sap.ui.unified"
	xmlns:tnt="sap.tnt">
	<Shell id="shell" appWidthLimited="false">
		<App id="app">
			<pages>
				<tnt:ToolPage id="toolPage" class="apPage">
					<tnt:header>
						<tnt:ToolHeader class="apHeader">
							<Button icon="sap-icon://menu2" type="Transparent" press="onToggleSideNav"
								tooltip="Show or hide the menu" class="apMenuButton"/>
							<HBox alignItems="Center">
								<VBox class="apLogo sapUiSmallMarginEnd" alignItems="Center" justifyContent="Center">
									<core:Icon src="sap-icon://shipping-status" size="1.25rem"/>
								</VBox>
								<VBox>
									<Title text="Accounts Payable Automation" level="H4" class="apBrandTitle"/>
									<Text text="Saudi Cargo" wrapping="false" class="apBrandSubtitle"/>
								</VBox>
							</HBox>
							<ToolbarSpacer/>
							<HBox alignItems="Center">
								<VBox alignItems="End" class="sapUiSmallMarginEnd">
									<Text text="{apData>/currentUser/name}" wrapping="false" class="apHeaderName"/>
									<Text text="{apData>/currentUser/roleLabel}" wrapping="false" class="apHeaderRole"/>
								</VBox>
								<Avatar initials="{apData>/currentUser/initials}" displaySize="XS"
									backgroundColor="{apData>/currentUser/avatarColor}" press="onOpenProfileMenu"
									tooltip="Profile" ariaHasPopup="Menu" class="apProfileAvatar"/>
							</HBox>
						</tnt:ToolHeader>
					</tnt:header>
					<tnt:sideContent>
						<tnt:SideNavigation selectedKey="{apData>/section}" itemSelect="onSectionSelect" class="apSideNav">
							<tnt:NavigationList>
								<tnt:NavigationListItem key="dashboard" text="Dashboard" icon="sap-icon://bbyd-dashboard"/>
								<tnt:NavigationListItem key="upload" text="Invoice Upload" icon="sap-icon://upload"
									visible="{apData>/permissions/processor}"/>
								<tnt:NavigationListItem key="review" text="Invoice Review" icon="sap-icon://inspect"/>
								<tnt:NavigationListItem key="approvals" icon="sap-icon://approvals"
									text="Approval Queue ({= ${apData>/approvals}.length })"/>
								<tnt:NavigationListItem key="audit" text="Audit Trail" icon="sap-icon://history"/>
							</tnt:NavigationList>
						</tnt:SideNavigation>
					</tnt:sideContent>
					<tnt:mainContents>
						<NavContainer id="sections" defaultTransitionName="show">
							<!-- Screen 1 — Dashboard and case worklist -->
							<Page id="dashboardSection" showHeader="false" backgroundDesign="Transparent" class="apSection">
								<VBox class="sapUiMediumMargin">
									<HBox class="apWelcome sapUiMediumMarginBottom" alignItems="Center"
										justifyContent="SpaceBetween" wrap="Wrap">
										<VBox>
											<Title text="{apData>/welcome/greeting}" level="H2"/>
											<Text text="{apData>/welcome/subtitle}" class="sapUiTinyMarginTop"/>
										</VBox>
										<HBox class="sapUiSmallMarginTopBottom">
											<Button text="Upload invoice" icon="sap-icon://upload" press="onGoUpload"
												visible="{apData>/permissions/processor}" class="apLightButton sapUiSmallMarginEnd"/>
											<Button text="Approval queue ({= ${apData>/approvals}.length })" icon="sap-icon://approvals"
												press="onGoQueue" visible="{apData>/permissions/approver}" class="apGhostButton"/>
										</HBox>
									</HBox>
									<HBox items="{apData>/kpiCards}" wrap="Wrap" class="apKpiRow sapUiMediumMarginBottom">
										<VBox class="apKpi">
											<customData>
												<core:CustomData key="tone" value="{apData>tone}" writeToDom="true"/>
											</customData>
											<HBox justifyContent="SpaceBetween" alignItems="Start">
												<VBox>
													<Text text="{apData>label}" class="apKpiLabel"/>
													<Text text="{apData>value}" class="apKpiValue sapUiTinyMarginTop"/>
												</VBox>
												<VBox class="apKpiIcon" alignItems="Center" justifyContent="Center">
													<core:Icon src="{apData>icon}" size="1.125rem"/>
												</VBox>
											</HBox>
										</VBox>
									</HBox>
									<VBox class="apCard">
										<!-- Wraps instead of overflowing, so the filter stays visible on narrow screens. -->
										<HBox alignItems="Center" justifyContent="SpaceBetween" wrap="Wrap" class="apCardHeader">
											<Title text="Cases" level="H3" class="apSectionTitle"/>
											<HBox alignItems="Center">
												<HBox items="{apData>/filterOptions}" wrap="Wrap" class="apFilter sapUiTinyMarginEnd">
													<ToggleButton text="{apData>text}" pressed="{= ${apData>key} === ${apData>/statusFilter} }"
														press="onStatusFilterPress" class="apFilterPill"/>
												</HBox>
												<Button icon="sap-icon://refresh" type="Transparent" tooltip="Refresh" press="onRefreshCases"/>
											</HBox>
										</HBox>
										<Table items="{apData>/cases}" fixedLayout="false" class="apTable">
											<noData>
												<IllustratedMessage illustrationType="sapIllus-NoEntries" illustrationSize="Spot"
													title="No cases here yet" description="Upload an invoice to start, or change the status filter."/>
											</noData>
											<columns>
												<Column><Text text="Invoice"/></Column>
												<Column><Text text="Supplier"/></Column>
												<Column hAlign="End"><Text text="Amount"/></Column>
												<Column hAlign="Center"><Text text="Status"/></Column>
												<Column><Text text="Created"/></Column>
											</columns>
											<items>
												<ColumnListItem type="Navigation" press="onCasePress">
													<cells>
														<ObjectIdentifier title="{apData>id}"/>
														<Text text="{apData>supplier}"/>
														<Text text="{apData>amount}" class="apAmount"/>
														<ObjectStatus text="{apData>status}" state="{apData>state}" inverted="true"/>
														<Text text="{apData>date}"/>
													</cells>
												</ColumnListItem>
											</items>
										</Table>
									</VBox>
								</VBox>
							</Page>
							<!-- Screen 2 — Invoice Upload -->
							<Page id="uploadSection" showHeader="false" backgroundDesign="Transparent" class="apSection">
								<VBox class="sapUiLargeMargin" alignItems="Center">
									<Title text="Upload an invoice" level="H2" class="apSectionTitle sapUiTinyMarginBottom"/>
									<Text text="The agents classify it (TOWER), extract the fields (LENS) and run the finance rules."
										class="sapUiMediumMarginBottom"/>
									<VBox class="apDropZone" alignItems="Center">
										<core:Icon src="sap-icon://upload-to-cloud" size="3rem" class="apDropIcon sapUiSmallMarginBottom"/>
										<Text text="PDF, PNG or JPEG · up to 20 MB" class="sapUiSmallMarginBottom"/>
										<u:FileUploader id="fileUploader" fileType="pdf,png,jpg,jpeg" sameFilenameAllowed="true"
											buttonText="Choose invoice" placeholder="Select a PDF, PNG or JPEG invoice"
											style="Emphasized" width="26rem" change="onUploadChange"
											enabled="{= !${apData>/busy} }"/>
									</VBox>
									<VBox visible="{apData>/upload/visible}" class="sapUiLargeMarginTop" alignItems="Center">
										<HBox items="{apData>/uploadSteps}" class="apSteps sapUiSmallMarginBottom" wrap="Wrap">
											<HBox class="apStep" alignItems="Center">
												<customData>
													<core:CustomData key="state" value="{apData>state}" writeToDom="true"/>
												</customData>
												<VBox class="apStepDot sapUiSmallMarginEnd" alignItems="Center" justifyContent="Center">
													<core:Icon src="{apData>icon}" size="0.875rem"/>
												</VBox>
												<VBox>
													<Text text="{apData>title}" class="apTimelineTitle"/>
													<Text text="{apData>text}" class="apTimelineMeta"/>
												</VBox>
											</HBox>
										</HBox>
										<ObjectStatus text="{apData>/upload/message}" state="{apData>/upload/state}" inverted="true"/>
									</VBox>
								</VBox>
							</Page>
							<!-- Screen 3 — Invoice Review -->
							<Page id="reviewSection" showHeader="false" backgroundDesign="Transparent" class="apSection">
								<Toolbar style="Clear" visible="{apData>/selectedInvoice/hasCase}">
									<Button text="Back to cases" icon="sap-icon://nav-back" type="Transparent" press="onNavBack"
										class="apBackLink"/>
								</Toolbar>
								<IllustratedMessage visible="{= !${apData>/selectedInvoice/hasCase} }"
									illustrationType="sapIllus-NoTasks" illustrationSize="Scene"
									title="No invoice selected" description="Open a case from the Dashboard or upload an invoice to review it here."/>
								<l:Splitter height="700px" visible="{apData>/selectedInvoice/hasCase}">
									<VBox class="sapUiSmallMargin">
										<layoutData>
											<l:SplitterLayoutData size="38%" minSize="300"/>
										</layoutData>
										<Title text="Original document" level="H4" class="apSectionTitle sapUiSmallMarginBottom"/>
										<Panel headerText="{apData>/selectedInvoice/fileName}" backgroundDesign="Solid" class="apDocPanel">
											<VBox alignItems="Center" justifyContent="Center" class="sapUiLargeMarginTop sapUiLargeMarginBottom">
												<core:Icon src="sap-icon://pdf-attachment" size="5rem" class="apDocIcon"/>
												<Text text="Supplier: {apData>/selectedInvoice/supplier}" class="sapUiSmallMarginTop"/>
												<Text text="Uploaded by: {apData>/selectedInvoice/createdBy}"/>
												<Text text="Last edited by: {apData>/selectedInvoice/editedBy}" class="sapUiSmallMarginBottom"/>
												<Button text="Open document" icon="sap-icon://doc-attachment" type="Emphasized"
													press="onOpenDocument" enabled="{= !!${apData>/selectedInvoice/documentUrl} }"/>
											</VBox>
										</Panel>
									</VBox>
									<!-- Placed directly in the Splitter: the ObjectPage fills its parent and needs a fixed height. -->
									<uxap:ObjectPageLayout id="ObjectPageLayout" showTitleInHeaderContent="true">
										<uxap:layoutData>
											<l:SplitterLayoutData size="62%" minSize="300"/>
										</uxap:layoutData>
										<uxap:headerTitle>
											<uxap:ObjectPageDynamicHeaderTitle>
												<uxap:expandedHeading>
													<Title text="{apData>/selectedInvoice/supplier}" wrapping="true"/>
												</uxap:expandedHeading>
												<uxap:snappedHeading>
													<Title text="{apData>/selectedInvoice/supplier}" wrapping="true"/>
												</uxap:snappedHeading>
												<uxap:expandedContent>
													<HBox alignItems="Center">
														<Text text="Invoice: {apData>/selectedInvoice/id}" class="sapUiMediumMarginEnd"/>
														<ObjectStatus text="{apData>/selectedInvoice/status}"
															state="{apData>/selectedInvoice/statusState}" inverted="true"/>
													</HBox>
												</uxap:expandedContent>
												<uxap:actions>
													<Button text="Save corrections" icon="sap-icon://save" type="Emphasized"
														press="onSaveCorrections" visible="{apData>/selectedInvoice/canEdit}"/>
													<Button text="Approve" icon="sap-icon://accept" type="Success" press="onApproveInvoice"
														visible="{apData>/selectedInvoice/canDecide}"/>
													<Button text="Return" icon="sap-icon://undo" press="onReturnInvoice"
														visible="{apData>/selectedInvoice/canDecide}"/>
													<Button text="Reject" icon="sap-icon://decline" type="Reject" press="onRejectInvoice"
														visible="{apData>/selectedInvoice/canDecide}"/>
												</uxap:actions>
											</uxap:ObjectPageDynamicHeaderTitle>
										</uxap:headerTitle>
										<uxap:sections>
											<uxap:ObjectPageSection title="Agent Results">
												<uxap:subSections>
													<uxap:ObjectPageSubSection>
														<VBox class="sapUiSmallMargin">
															<MessageStrip text="{apData>/selectedInvoice/reviewReason}" type="Warning" showIcon="true"
																visible="{= !!${apData>/selectedInvoice/reviewReason} }" class="sapUiSmallMarginBottom"/>
															<HBox class="sapUiSmallMarginBottom" wrap="Wrap">
																<ObjectStatus title="Document type" text="{apData>/selectedInvoice/documentType}" class="sapUiLargeMarginEnd"/>
																<ObjectStatus title="Classification confidence" text="{apData>/selectedInvoice/classificationConfidence}" class="sapUiLargeMarginEnd"/>
																<ObjectStatus title="Agent mode" text="{apData>/selectedInvoice/agentMode}"/>
															</HBox>
															<Title text="Checks" level="H5" class="apSectionTitle sapUiTinyMarginBottom"/>
															<HBox wrap="Wrap" class="apChips sapUiSmallMarginBottom" items="{apData>/selectedInvoice/checks}">
																<ObjectStatus text="{apData>name}: {apData>value}" state="{apData>state}" inverted="true"/>
															</HBox>
															<Title text="Agent steps" level="H5" class="apSectionTitle sapUiSmallMarginTop sapUiTinyMarginBottom"/>
															<List items="{apData>/selectedInvoice/agentTrace}" showSeparators="None" class="apTimeline"
																noDataText="No agent steps recorded">
																<CustomListItem>
																	<VBox class="apTimelineItem">
																		<customData>
																			<core:CustomData key="tone" value="{apData>tone}" writeToDom="true"/>
																		</customData>
																		<VBox class="apTimelineDot" alignItems="Center" justifyContent="Center">
																			<core:Icon src="{apData>icon}" size="0.75rem"/>
																		</VBox>
																		<Text text="{apData>title}" class="apTimelineTitle"/>
																		<Text text="{apData>description}" class="apTimelineText"/>
																		<Text text="{apData>meta}" class="apTimelineMeta"/>
																	</VBox>
																</CustomListItem>
															</List>
															<Title text="Findings" level="H5" class="apSectionTitle sapUiSmallMarginTop sapUiTinyMarginBottom"/>
															<List items="{apData>/selectedInvoice/findings}" noDataText="No findings">
																<StandardListItem title="{apData>text}" icon="{apData>icon}" wrapping="true"/>
															</List>
														</VBox>
													</uxap:ObjectPageSubSection>
												</uxap:subSections>
											</uxap:ObjectPageSection>
											<uxap:ObjectPageSection title="Invoice Fields">
												<uxap:subSections>
													<uxap:ObjectPageSubSection>
														<Table items="{apData>/selectedInvoice/fields}" fixedLayout="false" class="apTable apFieldsTable">
															<headerToolbar>
																<OverflowToolbar>
																	<Text text="Fields can be corrected while the case needs review, was returned or failed processing."
																		visible="{apData>/selectedInvoice/canEdit}"/>
																</OverflowToolbar>
															</headerToolbar>
															<columns>
																<Column><Text text="Field"/></Column>
																<Column><Text text="Value"/></Column>
															</columns>
															<items>
																<ColumnListItem>
																	<cells>
																		<Text text="{apData>field}"/>
																		<Input value="{apData>value}" editable="{apData>/selectedInvoice/canEdit}"
																			valueState="{= ${apData>needsAttention} ? 'Warning' : 'None' }"
																			valueStateText="Required before approval"/>
																	</cells>
																</ColumnListItem>
															</items>
														</Table>
													</uxap:ObjectPageSubSection>
												</uxap:subSections>
											</uxap:ObjectPageSection>
										</uxap:sections>
									</uxap:ObjectPageLayout>
								</l:Splitter>
							</Page>
							<!-- Screen 4 — Approval Queue -->
							<Page id="approvalsSection" showHeader="false" backgroundDesign="Transparent" class="apSection">
								<VBox class="sapUiMediumMargin">
									<Title text="Invoices awaiting a decision" level="H3" class="apSectionTitle sapUiSmallMarginBottom"/>
									<VBox class="apCard">
										<Table items="{apData>/approvals}" fixedLayout="false" class="apTable">
											<noData>
												<IllustratedMessage illustrationType="sapIllus-NoTasks" illustrationSize="Spot"
													title="Nothing waiting for a decision" description="Invoices that need review or were returned show up here."/>
											</noData>
											<columns>
												<Column hAlign="Center"><Text text="Invoice"/></Column>
												<Column hAlign="Center"><Text text="Supplier"/></Column>
												<Column hAlign="Center"><Text text="Amount"/></Column>
												<Column hAlign="Center"><Text text="Status"/></Column>
												<Column hAlign="Center"><Text text="Last edited by"/></Column>
												<Column visible="{apData>/permissions/approver}" hAlign="Center"><Text text="Actions"/></Column>
											</columns>
											<items>
												<ColumnListItem type="Navigation" press="onCasePress">
													<cells>
														<ObjectIdentifier title="{apData>id}"/>
														<Text text="{apData>supplier}"/>
														<Text text="{apData>amount}" class="apAmount"/>
														<ObjectStatus text="{apData>status}" state="{apData>state}" inverted="true"/>
														<Text text="{apData>editedBy}"/>
														<HBox justifyContent="Center" wrap="NoWrap">
															<Button text="Approve" icon="sap-icon://accept" type="Success" class="sapUiTinyMarginEnd" press="onApproveInvoice"/>
															<Button text="Return" icon="sap-icon://undo" class="sapUiTinyMarginEnd" press="onReturnInvoice"/>
															<Button text="Reject" icon="sap-icon://decline" type="Reject" press="onRejectInvoice"/>
														</HBox>
													</cells>
												</ColumnListItem>
											</items>
										</Table>
									</VBox>
								</VBox>
							</Page>
							<!-- Screen 5 — Audit Trail of the selected case -->
							<Page id="auditSection" showHeader="false" backgroundDesign="Transparent" class="apSection">
								<VBox class="sapUiMediumMargin">
									<Title text="History of invoice {apData>/selectedInvoice/id}" level="H3"
										class="apSectionTitle sapUiMediumMarginBottom" visible="{apData>/selectedInvoice/hasCase}"/>
									<IllustratedMessage visible="{= !${apData>/selectedInvoice/hasCase} }"
										illustrationType="sapIllus-NoActivities" illustrationSize="Scene"
										title="No case selected" description="Open a case from the Dashboard to see its full history."/>
									<VBox class="apCard sapUiSmallMarginBottom" visible="{apData>/selectedInvoice/hasCase}">
										<List items="{apData>/auditTrail}" showSeparators="None" class="apTimeline sapUiSmallMargin">
											<CustomListItem>
												<VBox class="apTimelineItem">
													<customData>
														<core:CustomData key="tone" value="{apData>tone}" writeToDom="true"/>
													</customData>
													<VBox class="apTimelineDot" alignItems="Center" justifyContent="Center">
														<core:Icon src="{apData>icon}" size="0.75rem"/>
													</VBox>
													<Text text="{apData>title}" class="apTimelineTitle"/>
													<Text text="{apData>description}" class="apTimelineText" visible="{= !!${apData>description} }"/>
													<Text text="{apData>meta}" class="apTimelineMeta"/>
												</VBox>
											</CustomListItem>
										</List>
									</VBox>
								</VBox>
							</Page>
						</NavContainer>
					</tnt:mainContents>
				</tnt:ToolPage>
			</pages>
		</App>
	</Shell>
</mvc:View>
