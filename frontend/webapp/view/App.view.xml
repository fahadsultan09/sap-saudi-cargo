<mvc:View
    controllerName="saudicargo.ap.automation.controller.App"
	xmlns:mvc="sap.ui.core.mvc"
	xmlns="sap.m"
	xmlns:tnt="sap.tnt">
	<Shell id="shell" appWidthLimited="false">
		<App id="app">
			<pages>
				<tnt:ToolPage id="toolPage" class="apPage">
					<tnt:header>
						<tnt:ToolHeader class="apHeader">
							<HBox alignItems="Center">
								<HBox class="apBrandMark" alignItems="Center" justifyContent="Center">
									<Text text="{client>/branding/markText}" class="apBrandMarkLetter"/>
								</HBox>
								<VBox class="apBrandText">
									<Title text="{client>/branding/appTitle}" level="H4" class="apBrandTitle"/>
									<Text text="{client>/branding/appSubtitle}" wrapping="false" class="apBrandSubtitle"/>
								</VBox>
							</HBox>
							<ToolbarSpacer/>
							<HBox alignItems="Center">
								<VBox alignItems="End" class="sapUiSmallMarginEnd">
									<Text text="{apData>/currentUser/name}" wrapping="false" class="apHeaderName"/>
									<Text text="{apData>/currentUser/roleLabel}" wrapping="false" class="apHeaderRole"/>
								</VBox>
								<Avatar initials="{apData>/currentUser/initials}" displaySize="XS"
									backgroundColor="{apData>/currentUser/avatarColor}" press="onOpenProfileMenu"
									tooltip="Account" ariaHasPopup="Menu" class="apProfileAvatar"/>
							</HBox>
						</tnt:ToolHeader>
					</tnt:header>
					<tnt:mainContents>
						<NavContainer id="sections" defaultTransitionName="show"/>
					</tnt:mainContents>
				</tnt:ToolPage>
			</pages>
		</App>
	</Shell>
</mvc:View>
