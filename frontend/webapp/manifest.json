{
    "_version": "1.59.0",
    "sap.app": {
        "id": "saudicargo.ap.automation",
        "type": "application",
        "title": "Saudi Cargo - AP Automation",
        "description": "AP Automation Prototype"
    },
    "sap.ui": {
        "technology": "UI5",
        "deviceTypes": {
            "desktop": true,
            "tablet": true,
            "phone": false
        }
    },
    "sap.ui5": {
        "resources": {
            "css": [
                {
                    "uri": "css/style.css"
                }
            ]
        },
        "rootView": {
            "viewName": "saudicargo.ap.automation.view.App",
            "type": "XML",
            "async": true,
            "id": "appView"
        },
        "dependencies": {
            "minUI5Version": "1.120.0",
            "libs": {
                "sap.ui.core": {},
                "sap.m": {},
                "sap.f": {},
                "sap.uxap": {},
                "sap.tnt": {},
                "sap.ui.layout": {},
                "sap.ui.unified": {}
            }
        },
        "models": {
            "config": {
                "type": "sap.ui.model.json.JSONModel",
                "uri": "model/config.json"
            }
        },
        "routing": {
            "config": {
                "routerClass": "sap.m.routing.Router",
                "type": "View",
                "viewType": "XML",
                "path": "saudicargo.ap.automation.view",
                "controlId": "sections",
                "controlAggregation": "pages",
                "transition": "show",
                "async": true
            },
            "routes": [
                { "name": "dashboard", "pattern": "", "target": "dashboard" },
                { "name": "upload", "pattern": "upload", "target": "upload" },
                { "name": "review", "pattern": "review/:caseId:", "target": "review" },
                { "name": "approvals", "pattern": "approvals", "target": "approvals" },
                { "name": "audit", "pattern": "audit", "target": "audit" }
            ],
            "targets": {
                "dashboard": { "id": "dashboard", "name": "Dashboard" },
                "upload": { "id": "upload", "name": "Upload" },
                "review": { "id": "review", "name": "Review" },
                "approvals": { "id": "approvals", "name": "Approvals" },
                "audit": { "id": "audit", "name": "Audit" }
            }
        }
    }
}
