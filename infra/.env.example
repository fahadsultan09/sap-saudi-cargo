# Copy to infra/.env (git-ignored) and fill in. Values here are placeholders, never real secrets.
CLIENT=saudi-cargo
AP_PUBLIC_URL=http://localhost:8000
KEYCLOAK_ADMIN_PASSWORD=change-me
# Must equal OIDC_CLIENT_SECRET in backend/.env.local
AP_GATEWAY_CLIENT_SECRET=change-me
# Development users only (see clients/<client>/keycloak-realm.json)
DEV_PASSWORD_FAIZAN=change-me
DEV_PASSWORD_SARA=change-me
